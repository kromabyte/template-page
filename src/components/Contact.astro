---

interface ContactInfo {
  icon: string;
  label: string;
  href?: string;
}

const contactInfo: ContactInfo[] = [
  { icon: "uil:map-marker", label: "El Peumo Lote B, Los Ángeles, Bio Bio, Chile" },
  { icon: "uil:envelope", label: "contacto@tuempresa.com", href: "mailto:contacto@tuempresa.com" },
  { icon: "uil:phone", label: "+56 9 98374390", href: "tel:+56998374390" },
];
---
<div
  class="relative mb-8 flex h-50 items-center justify-center overflow-hidden bg-cover bg-center px-6"
  style="background-image: url(/hero-2.jpg);"
>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 text-center">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Contacto</h1>
    <p class="mt-4 text-base text-slate-200 sm:text-lg md:text-xl">Estamos aquí para ayudarte.</p>
  </div>
</div>

<section class="mx-auto max-w-4xl px-6 pb-16 text-center md:px-10">
  <div class="mt-12 flex flex-col items-center gap-10 sm:flex-row sm:justify-center ">
    <div>
      <h2 class="text-2xl font-medium text-gray-800">¿Tienes alguna consulta? contáctanos directamente.</h2>
      <p class="mt-3 leading-relaxed text-slate-500">
        No lo dudes.
      </p>

      <div class="mt-5 space-y-3 flex flex-col items-center gap-3">
        {contactInfo.map((item) => {
          const [prefix, name] = item.icon.split(":");
          return (
            <div class="flex items-center gap-2 text-gray-600">
              <img src={`https://api.iconify.design/${prefix}/${name}.svg`} alt="" class="h-7 w-7" />
              {item.href ? (
                <a href={item.href} class="text-lg font-semibold bg-linear-to-r from-black via-green-700 via-60% to-green-600 bg-clip-text text-transparent hover:underline">{item.label}</a>
              ) : (
                <span class="text-lg font-semibold bg-linear-to-r from-black via-green-700 via-60% to-green-500 bg-clip-text text-transparent" >{item.label}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>