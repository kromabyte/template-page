---
const socialLinks = [
  {
    name: "Instagram",
    icon: "mdi:instagram",
    href: "https://www.instagram.com/altosdelcaliboro/",
  },
  {
    name: "Facebook",
    icon: "mdi:facebook",
    href: "",
  },
];
---

<div class="pb-15 text-center">
  <p class="mb-3 text-xl sm:text-2xl font-semibold text-slate-800">
    Siguenos en Redes Sociales.
  </p>

  <div class="flex justify-center gap-3">
    {socialLinks.map((social) => {
      const [prefix, name] = social.icon.split(":");

      return (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-transform duration-200 hover:scale-120"
          aria-label={social.name}
        >
          <img
            src={`https://api.iconify.design/${prefix}/${name}.svg?color=%23333`}
            class="h-10 w-10 "
            alt={social.name}
          />
        </a>
      );
    })}
  </div>
</div>