---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

interface MenuItem {
  title: string;
  path: string;
}

const menuItems: MenuItem[] = [
  { title: "Nosotros", path: "/about" },
  { title: "Catalogo", path: "/catalog" },
  { title: "Contacto", path: "/contact" },
];
---

<header class="sticky top-0 z-50 flex flex-wrap items-center justify-between bg-white px-6 py-5 shadow-md sm:px-10">
  <Astronav>
    <a href="/" class="bg-linear-to-r from-black via-green-700 via-40% to-green-500 bg-clip-text text-xl font-bold text-transparent">Altos del Caliboro</a>

    <div class="order-2 flex items-center gap-4 sm:order-3">
      <MenuIcon class="h-7 w-7 text-gray-800 sm:hidden" />
      <a href="/" aria-label="Carrito de compras">
        <img src="https://api.iconify.design/streamline-flex/salad-vegetable-diet-solid.svg?color=%2314532d" alt="" class="h-7 w-7" />
      </a>
    </div>

    <MenuItems class="order-3 mt-3 hidden w-full sm:order-2 sm:mt-0 sm:flex sm:w-auto">
      <ul class="flex flex-col gap-3 sm:flex-row sm:items-center">
        {menuItems.map((item) => (
          <li>
            <a href={item.path} class="flex py-2 text-gray-600 hover:text-gray-900 sm:px-3">
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </MenuItems>
  </Astronav>
</header>