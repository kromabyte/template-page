---
---
<form class="flex flex-col gap-4 mb-10">
  <div>
    <label for="name" class="text-sm font-medium text-gray-700">Nombre</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:border-black focus:outline-none"
    />
  </div>

  <div>
    <label for="email" class="text-sm font-medium text-gray-700">Correo</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:border-black focus:outline-none"
    />
  </div>

  <div>
    <label for="message" class="text-sm font-medium text-gray-700">Mensaje</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 focus:border-black focus:outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="rounded-md bg-black px-6 py-3 text-sm font-semibold text-white hover:bg-gray-800"
  >
    Enviar
  </button>
</form>