---
interface Props {
    title?: string;
    description?: string;
    backgroundImage?: string;
    ctaText?: string;
    ctaHref?: string;
}

const {
    title = "Hortalizas seleccionadas y calibradas ",
    description = "Una descripción breve que explique tu propuesta de valor.",
    backgroundImage = "/hero.png",
    ctaText = "Catalogo",
    ctaHref = "/#contacto",
} = Astro.props;
---

<section class="relative flex min-h-[80vh] items-center justify-center bg-cover bg-center px-6 py-20 sm:min-h-[90vh] md:px-10"
    style={`background-image: url(${backgroundImage});`}>
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 max-w-4xl text-center mt-50">
        <h1 class="text-3xl font-bold text-white sm:text-4xl md:text-5xl lg:text-6xl">
            {title}
        </h1>
        <p class="mt-4 text-base text-slate-200 sm:text-lg md:text-xl">
            {description}
        </p>
        <a href={ctaHref} class="mt-8 inline-block rounded-md bg-black px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-800 sm:text-base">
            {ctaText}
        </a>
    </div>
</section>

