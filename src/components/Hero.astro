---
interface Props {
    title?: string;
    description?: string;
    backgroundImage?: string;
    ctaText?: string;
    ctaHref?: string;
}

const {
    title = "Hortalizas seleccionadas y calibradas para tu cocina.",
    description = "",
    backgroundImage = "/hero.png",
    ctaText = "Catalogo",
    ctaHref = "/catalog",
} = Astro.props;
---

<section class="relative flex h-[70vh] items-center justify-center overflow-hidden bg-cover bg-center px-6 py-12 sm:h-155 sm:py-20 md:px-10"
    style={`background-image: url(${backgroundImage});`}>
    <div class="absolute inset-0 bg-black/10"></div>

    <div class="relative z-10 max-w-4xl text-center mb-50 mt-40">
        <h1 class="text-4xl font-bold text-white sm:text-4xl md:text-5xl lg:text-6xl">
            {title}
        </h1>
        <p class="mt-4 text-base text-slate-200 sm:text-lg md:text-xl">
            {description}
        </p>
        <a href={ctaHref} class="mt-8 inline-flex items-center gap-1 rounded-md bg-black px-6 py-3 text-sm font-semibold text-white transition hover:bg-green-400 sm:text-base">
            <img src="https://api.iconify.design/healthicons/vegetables.svg?color=%23ffffff" alt="" class="h-8 w-8" />

            {ctaText}
       </a>
    </div>
</section>

