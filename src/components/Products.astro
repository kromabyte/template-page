---
interface Product {
  name: string;
  price: string;
  image: string;
}

const products: Product[] = [
  { name: "Papas", price: "$1.990 kg", image: "/papas.jpeg" },
  { name: "Betarraga", price: "$1.490 kg", image: "/beta.jpg" },
  { name: "cilantro", price: "$1.290 kg", image: "/cilantro.jpg" },
  { name: "pepinos", price: "$990 kg", image: "/pepinos.jpg" },
];
---

<section class="px-6 py-16 md:px-10">
    <h2 class="text-center text-3xl font-bold sm:text-4xl mb-20">Productos</h2>
    
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {products.map((product) => (
      <div class="flex flex-col">
        <div class="rounded-nonex shadow-md">
          <img
            src={product.image}
            alt={product.name}
            class="aspect-square w-full rounded-none object-cover"
          />
        </div>
        <p class="mt-3 text-sm text-slate-600">{product.name}</p>
        <p class="mt-1 font-semibold">{product.price}</p>
      </div>
    ))}
  </div>
</section>