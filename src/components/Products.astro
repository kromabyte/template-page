---
interface Product {
  name: string;
  format: string;
  netPrice: string;
  totalPrice: string;
  image: string;
}

const products: Product[] = [
  { name: "Papas Pelada Bastón (Al vacío)", format: "bolsa 1.0 kg", netPrice: "$1.220", totalPrice: "$1.456", image: "/products/papas/papa-baston.jpg" },
  { name: "Zanahoria Corte Bastón (Al vacío)", format: "Bolsa 0.5 kg", netPrice: "$900", totalPrice: "$1.071", image: "/products/zanahorias/zana-03.jpg" },
  { name: "Limón en Malla", format: "Malla 10 kg", netPrice: "$8.000", totalPrice: "$9.520", image: "/products/citricos/limon.jpg" },
  { name: "Beterraga Pelada Picada (Al vacío)", format: "Bolsa 1.0 kg", netPrice: "$1.500", totalPrice: "$1.785", image: "/products/betarragas/betarraga-03.jpg" },
];
---

<section class="px-6  pt-8 md:px-10">
  <h2 class="bg-linear-to-r from-black via-green-700 via-60% to-green-500 mb-10 text-center  text-3xl font-bold sm:text-4xl bg-clip-text text-transparent">Productos Destacados</h2>

  <div class="grid grid-cols-2 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
    {products.map((product) => (
      <a href="/catalog" class="group flex flex-col">
        <div class="relative overflow-hidden rounded-lg shadow-md">
          <span class="absolute -right-10 top-4 z-10 w-36 rotate-45 bg-[#d4af37] py-1 text-center text-xs font-semibold text-white">
            Destacado
          </span>
          <img
            src={product.image}
            alt={product.name}
            class="aspect-square w-full rounded-lg object-cover transition group-hover:scale-105"
          />
        </div>
        <p class="mt-3 text-sm font-medium text-slate-700">{product.name}</p>
        <p class="text-xs text-slate-500">{product.format}</p>
        <p class="mt-1 text-sm font-semibold text-slate-800">
          {product.totalPrice} <span class="text-xs font-normal text-slate-400">c/IVA</span>
        </p>
        <p class="text-xs text-slate-400">Neto: {product.netPrice}</p>
      </a>
    ))}
  </div>
</section>