---

<div
  class="relative flex h-50 items-center justify-center overflow-hidden bg-cover bg-center px-6"
  style="background-image: url(/hero-5.jpg);"
>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 text-center">
    <h1 class="text-3xl font-bold text-white sm:text-4xl">Catálogo</h1>
    <p class="mt-4 text-base text-slate-200 sm:text-lg md:text-xl">
      Nuestro catálogo de productos frescos y de calidad, listos para ser entregados en tu cocina.
    </p>
  </div>
</div>

<section class="px-6 py-4 md:px-10">
  {catalog.map((category) => (
    <div class="mt-16 first:mt-2">
      <h2 class="text-2xl font-bold text-slate-800">{category.title}</h2>
      <p class="mt-2 max-w-2xl text-slate-500">{category.description}</p>

      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8 lg:grid-cols-4">
        {category.products.map((product) => (
          <div class="flex flex-col">
            <div class="rounded-lg shadow-md">
              <div class="relative overflow-hidden rounded-lg">
                {product.featured && (
                  <span class="absolute -right-10 top-4 z-10 w-36 rotate-45 bg-[#d4af37] py-1 text-center text-xs font-semibold text-white">
                    Destacado
                  </span>
                )}
                <img
                  src={product.image}
                  alt={product.name}
                  class="aspect-square w-full rounded-lg object-cover"
                />
              </div>
            </div>
            <p class="mt-3 text-md font-medium text-slate-700">{product.name}</p>
            <p class="text-sm text-slate-500">{product.format}</p>
            <p class="mt-1 text-md font-semibold text-slate-800">
              {product.totalPrice} <span class="text-sm font-normal text-slate-400">c/IVA</span>
            </p>
            <p class="text-sm text-slate-400">Neto: {product.netPrice}</p>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>