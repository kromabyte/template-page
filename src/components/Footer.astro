---
import { Image } from "astro:assets";
import logoSrc from "../assets/astro.svg";

interface FooterLink {
  title: string;
  path: string;
}

interface SocialLink {
  name: string;
  slug: string;
  href: string;
}

const companyLinks: FooterLink[] = [
  { title: "Sobre nosotros", path: "/#nosotros" },
  { title: "Servicios", path: "/#servicios" },
  { title: "Contacto", path: "/#contacto" },
];

const legalLinks: FooterLink[] = [
  { title: "Términos y condiciones", path: "/terminos" },
  { title: "Política de privacidad", path: "/privacidad" },
];

const socialLinks: SocialLink[] = [
  { name: "Instagram", slug: "instagram", href: "https://instagram.com" },
  { name: "X (Twitter)", slug: "x", href: "https://x.com" },
  { name: "LinkedIn", slug: "linkedin", href: "https://linkedin.com" },
  { name: "Facebook", slug: "facebook", href: "https://facebook.com" },
];
---

<footer class="bg-zinc-900 px-6 py-12 text-slate-300 md:px-10">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-4">
    <div>
      <Image src={logoSrc} alt="Logo" width={60} height={60} />
      <p class="mt-3 text-sm text-slate-400">
        Av. Providencia 1234, Of. 501<br />
        Santiago, Chile
      </p>
      <p class="mt-2 text-sm text-slate-400">
        contacto@tuempresa.com<br />
        +56 9 1234 5678
      </p>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Empresa</h3>
      <ul class="space-y-2">
        {companyLinks.map((link) => (
          <li>
            <a href={link.path} class="text-sm text-slate-400 hover:text-white">{link.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Legal</h3>
      <ul class="space-y-2">
        {legalLinks.map((link) => (
          <li>
            <a href={link.path} class="text-sm text-slate-400 hover:text-white">{link.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Síguenos</h3>
      <div class="flex gap-4">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener" aria-label={social.name}>
            <img
              src={`https://cdn.simpleicons.org/${social.slug}/ffffff`}
              alt={social.name}
              class="h-5 w-5 opacity-80 transition hover:opacity-100"
            />
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="bottom-px" >
    <p class="text-center text-sm text-slate-500">
      Copyright © {new Date().getFullYear()} Kromacoin. All rights reserved.
    </p>

    <p class="text-center text-xs text-slate-500 mt-1">
      Made by <a
        href="https://web3templates.com"
        target="_blank"
        rel="noopener"
        class="hover:underline">
        kromabyte.
      </a>
    </p>
  </div>
</footer>