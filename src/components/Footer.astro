---
import { Image } from "astro:assets";
import logoSrc from "../assets/astro.svg";

interface FooterLink {
  title: string;
  path: string;
}

interface SocialLink {
  name: string;
  slug: string;
  href: string;
}

const companyLinks: FooterLink[] = [
  { title: "Sobre nosotros", path: "/about" },
  { title: "Servicios", path: "/catalog" },
  { title: "Contacto", path: "/contact" },
];

const legalLinks: FooterLink[] = [
  { title: "Términos y condiciones", path: "" },
  { title: "Política de privacidad", path: "" },
];

const socialLinks: SocialLink[] = [
  { name: "Instagram", slug: "instagram", href: "https://www.instagram.com/altosdelcaliboro/" },
  { name: "X (Twitter)", slug: "x", href: "https://x.com" },
  { name: "Tiktok", slug: "Tiktok", href: "https://www.tiktok.com" },
  { name: "Facebook", slug: "facebook", href: "https://facebook.com" },
];
---

<footer class="bg-zinc-900 px-6 py-12 text-slate-300 md:px-10">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 md:grid-cols-4">
    <div>
        <a href="/" class="bg-linear-to-r from-white via-green-500 via-100% to-green-600 bg-clip-text text-xl font-bold text-transparent">Altos del Caliboro</a>
        <!-- <Image src={logoSrc} alt="Logo" width={60} height={60} /> -->
        <p class="mt-3 text-sm text-slate-400">
        El Peumo Lote B, Los Ángeles,<br />
        Bio Bio, Chile
      </p>
      <p class="mt-2 text-sm text-slate-400">
        contacto@altosdelcaliboro.com<br />
        +56 9 98374390
      </p>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Empresa</h3>
      <ul class="space-y-2">
        {companyLinks.map((link) => (
          <li>
            <a href={link.path} class="text-sm text-slate-400 hover:text-white">{link.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Legal</h3>
      <ul class="space-y-2">
        {legalLinks.map((link) => (
          <li>
            <a href={link.path} class="text-sm text-slate-400 hover:text-white">{link.title}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-white">Síguenos</h3>
      <div class="flex gap-4">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener" aria-label={social.name}>
            <img
              src={`https://cdn.simpleicons.org/${social.slug}/ffffff`}
              alt={social.name}
              class="h-5 w-5 opacity-80 transition hover:opacity-100"
            />
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="bottom-px pt-5" >
    <p class="text-center text-sm text-slate-500">
      Copyright © {new Date().getFullYear()}. All rights reserved.
    </p>

    <p class="text-center text-xs text-slate-500 mt-1">
      Made by <a
        href="https://web3templates.com"
        target="_blank"
        rel="noopener"
        class="hover:underline">
        KromaByte.
      </a>
    </p>
  </div>
</footer>