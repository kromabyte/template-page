---
interface Feature {
  title: string;
  description: string;
  icon: string;
}

const features: Feature[] = [
  {
    title: "Confianza para tu negocio.",
    description:
      "Build your site using React, Svelte, Vue, Preact, web components, or just plain ol' HTML + JavaScript.",
    icon: "bx:bxs-shopping-bag",
  },
  {
    title: "Entregas a tu cocina.",
    description:
      "Astro renders your entire page to static HTML, removing all JavaScript from your final build by default.",
    icon: "bx:bxs-coin",
  },
  {
    title: "Productos de calidad.",
    description:
      "Need some JS? Astro can automatically hydrate interactive components when they become visible on the page.",
    icon: "bx:bxs-data",
  },
];
---

<div class="px-10">

  <div class="mt-16 grid gap-16 sm:grid-cols-2 md:grid-cols-3 ">
    {features.map((item) => {
      const [prefix, name] = item.icon.split(":");
      return (
        <div class="flex items-start gap-4">
          <div class="mt-1 h-8 w-8 shrink-0 rounded-full bg-black p-2">
            <img
              src={`https://api.iconify.design/${prefix}/${name}.svg?color=%23ffffff`}
              alt=""
              class="h-full w-full"
            />
          </div>
          <div>
            <h3 class="text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-500">{item.description}</p>
          </div>
        </div>
      );
    })}
  </div>
</div>